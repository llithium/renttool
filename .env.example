# Optional: used by `bun run images:unsplash` for the Unsplash importer.
# The default Wikimedia importer and the running app do not need a key.
UNSPLASH_ACCESS_KEY=

# Optional: dedicated OSRM driving server base URL (must support the table service).
# Default is the FOSSGIS public service, for light interactive usage only.
COMMUTE_OSRM_URL=
