# Maintainer-only: used by `bun run images:refresh` to update the checked-in
# city-image manifest. It is not needed by the running app.
UNSPLASH_ACCESS_KEY=

# Optional: dedicated OSRM driving server base URL (must support the table service).
# Default is the FOSSGIS public service, for light interactive usage only.
COMMUTE_OSRM_URL=
